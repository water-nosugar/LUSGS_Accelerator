+    def test_cumulative_snapshots_are_not_summed(self):
+        rows = [dict(bank='0', read_words='20', write_words='10'),
+                dict(bank='1', read_words='10', write_words='5'),
+                dict(bank='0', read_words='40', write_words='20'),
