{
  "campaign": "coeff-streaming-auto-retire",
  "common_args": [
    "--bench-iters=1",
    "--lusgs-mode=step2-pretransform-raw-optprep-stream",
    "--coeff-preprocess-model=event",
    "--lu5-model=event",
    "--coeff-validation=full",
    "--coeff-stream-retire-mode=auto",
    "--lusgs-lines=1"
