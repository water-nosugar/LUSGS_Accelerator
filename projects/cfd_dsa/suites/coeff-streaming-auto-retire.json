      "target": "lusgs-step2",
      "args": ["--lusgs-cells=17", "--coeff-stream-window=4", "--coeff-spm-model=packet", "--coeff-spm-outstanding=1"]
    },
    {
      "name": "bank-conflict",
      "target": "lusgs-step2",
      "args": ["--lusgs-cells=17", "--coeff-stream-window=4", "--coeff-spm-model=packet", "--coeff-spm-banks=1"]
    },
    {
      "name": "cancel-regression-coexistence",
      "target": "lusgs-step2",
      "args": ["--lusgs-cells=17", "--coeff-stream-window=4", "--coeff-cancel-test=1"]
    }
  ]
